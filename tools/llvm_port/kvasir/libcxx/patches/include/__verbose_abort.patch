Kvasir patch: libcxx include/__verbose_abort
Why:       every libc++ abort (_LIBCPP_VERBOSE_ABORT: an empty optional's value(), a variant's bad access, ...)
           must leave a catalogued log line (uc_log::log_assert) and a panic record (Kvasir::Panic::raise,
           Cause::assertion = 0) instead of upstream's __libcpp_verbose_abort + abort(), which has no
           log and no record. It also defines INTERNAL_abort_lambda, which the Kvasir-owned
           include/__assertion_handler tests to route the hardening checks the same way. Constant
           evaluation gets an out-of-bounds write instead: a compile error.
Upstream:  none - Kvasir glue (uc_log, Kvasir::Panic), not upstreamable.
Proof:     test_examples 99_checked_asserts, request 8 in the sanitize build (std::array out of range): libc++'s
           message, then a panic with cause assertion - without this patch __assertion_handler falls
           back to _LIBCPP_VERBOSE_ABORT("%s", ...).
Drop when: never; on each port check that upstream still defines _LIBCPP_VERBOSE_ABORT in this file.

--- a/include/__verbose_abort
+++ b/include/__verbose_abort
@@ -16,6 +16,39 @@
 #  pragma GCC system_header
 #endif
 
+#  if _LIBCPP_AVAILABILITY_HAS_VERBOSE_ABORT
+
+namespace uc_log {
+extern void log_assert(int Line, const char* Filename, const char* Expr);
+}
+
+// Kvasir_SDK kvasir/Util/Panic.hpp: every fatal path ends in raise(); Cause::assertion is 0 and
+// the underlying type unsigned char, fixed on both sides.
+#ifndef KVASIR_PANIC_RAISE_DECLARED
+#define KVASIR_PANIC_RAISE_DECLARED 1
+namespace Kvasir { namespace Panic {
+enum class Cause : unsigned char;
+[[noreturn]] void raise(Cause);
+}}
+#endif
+
+#define INTERNAL_abort_lambda(x)                                  \
+    []() __attribute__((__noreturn__)) {                          \
+        if(__builtin_is_constant_evaluated()) {                   \
+            int DO_NOT_USE_see_assert[1];                         \
+            DO_NOT_USE_see_assert[1] = 0;                         \
+        } else {                                                  \
+            uc_log::log_assert(                                   \
+              __LINE__,                                           \
+              __FILE_NAME__,                                      \
+              #x);                                                \
+            ::Kvasir::Panic::raise(                               \
+              static_cast<::Kvasir::Panic::Cause>(0));            \
+        }                                                         \
+    }                                                             \
+    ()
+#endif
+
 _LIBCPP_BEGIN_NAMESPACE_STD
 
 // This function should never be called directly from the code -- it should only be called through
@@ -44,7 +77,7 @@
 void __use(const char*, ...);
 #    define _LIBCPP_VERBOSE_ABORT(...) (decltype(::std::__use(__VA_ARGS__))(), __builtin_abort())
 #  else
-#    define _LIBCPP_VERBOSE_ABORT(...) ::std::__libcpp_verbose_abort(__VA_ARGS__)
+#    define _LIBCPP_VERBOSE_ABORT(msg, ...) INTERNAL_abort_lambda(msg)
 #  endif
 
 #endif // !defined(_LIBCPP_VERBOSE_ABORT)
